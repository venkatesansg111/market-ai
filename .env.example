# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=market_ai
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Ingestion behaviour ───────────────────────────────────────
# How many months of history to backfill
HISTORY_MONTHS=24

# Seconds between monthly chunk requests (rate-limit protection)
REQUEST_DELAY_SECONDS=1.0

# Retry settings
MAX_RETRIES=3
RETRY_BACKOFF_SECONDS=5.0

# Rows per INSERT batch
BATCH_SIZE=500

# ── Provider ──────────────────────────────────────────────────
# "yfinance" | "nse"
DATA_PROVIDER=yfinance

# ── Instruments (comma-separated) ────────────────────────────
INSTRUMENTS=NIFTY 50,NIFTY BANK

# ── Timeframes (comma-separated) ─────────────────────────────
# Available: 1min, 5min, 15min, 1day
TIMEFRAMES=1min,5min,15min,1day

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
